        name: "clk"
        side: 3
        offset_pct: 0.3500
      - id: 22
        name: "rst_n"
        side: 3
        offset_pct: 0.6500
      - id: 23
        name: "q_out[3:0]"
        side: 1
        offset_pct: 0.5000
