      subsystem_type: "builtin"
      embedded_graph_yaml: "# Madí Subsystem Internal Diagram\nschema_version: 1\nnodes:\n  - id: 10\n    name: \"Increment Logic\"\n    shape: 0\n    bounds: [80.0, 60.0, 140.0, 70.0]\n  - id: 20\n    name: \"DFF Register [3:0]\"\n    shape: 0\n    bounds: [300.0, 60.0, 150.0, 70.0]\nedges:\n  - id: 101\n    source_node: 10\n    target_node: 20\n    arrowhead: \"classic\"\n    waypoints:\n      - [220.0, 95.0]\n      - [300.0, 95.0]\n"
    ports:
