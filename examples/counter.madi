# Madí Diagram Model - Model, Align & Diagram Interconnects
# Homage to Arte Madí (Buenos Aires, 1946) — Broken Canvas, Linear Grids & Articulated Spatial Structures
schema_version: 1
nodes:
  - id: 1
    name: "Clock & Reset Gen"
    shape: 0
    bounds: [60.0000, 100.0000, 160.0000, 80.0000]
    ports:
      - id: 11
        name: "clk"
        side: 1
        offset_pct: 0.3500
      - id: 12
        name: "rst_n"
